# Databricks Forge npm config
#
# legacy-peer-deps=true
#   Use the pre-npm 7 peer-dependency resolver. The Databricks Apps build
#   server runs npm 10.9.x, which has a known "Exit handler never called!"
#   crash that triggers under heavy ERESOLVE peer-override cascades. This
#   forces npm to skip strict peer-dep resolution and prevents that crash
#   path even if a future bump introduces conflicting peer ranges.
#
# fund=false / audit=false
#   Cosmetic / unrelated to install correctness; speeds up CI and the
#   Databricks Apps build server which has no use for either.
legacy-peer-deps=true
fund=false
audit=false
